# Copia este archivo a .env (desarrollo) y a .env.test (tests) y rellena los valores.

# PostgreSQL. En .env.test la base de datos DEBE acabar en _test (los tests la vacían).
DATABASE_URL="postgresql://postgres:CONTRASEÑA@localhost:5432/tope?schema=public"

# Dirección pública de la web (https en producción) y secreto de sesión.
# Secreto: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
